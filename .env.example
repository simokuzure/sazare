# 复制为 .env 后填写；启动脚本只将这些配置传给后端。
# 已在终端设置的环境变量优先于此文件。仅支持 AI_、OPENAI_、GOOGLE_AI_ 开头的配置。
# 每行 NAME=value，可用成对的单/双引号包裹值；仅支持整行注释，不进行变量替换或转义。
AI_PROVIDER=google
GOOGLE_AI_API_KEY=

# OpenAI 文本功能：将 AI_PROVIDER 改为 openai，并填写以下密钥。
# 语音转写和向量生成仍需要上面的 Google 密钥。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# 可选配置，未设置时沿用 backend/src/main/resources/application.yml 的默认值。
# OPENAI_BASE_URL=https://api.openai.com/v1
# GOOGLE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_REQUEST_TIMEOUT=300s
# 无真实密钥时，可设置 AI_PROVIDER=mock 使用模拟文本实现。
