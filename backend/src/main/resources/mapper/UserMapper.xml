<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jt.learning.mapper.UserMapper">

    <select id="selectEnabledUserByCode" resultType="com.jt.learning.entity.User">
        select
            id,
            user_code,
            nickname,
            user_type,
            enabled,
            deleted,
            created_at,
            updated_at
        from users
        where user_code = #{userCode}
          and enabled = true
          and deleted = false
    </select>
</mapper>
