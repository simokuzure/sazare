<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jt.learning.mapper.TagMapper">

    <sql id="tagWhereClause">
        where deleted = false
        <if test="enabledOnly">
            and enabled = true
        </if>
        <if test="tagType != null">
            and tag_type = #{tagType}
        </if>
        <if test="parentId != null">
            and parent_id = #{parentId}
        </if>
    </sql>

    <select id="countTags" resultType="long">
        select count(1)
        from tags
        <include refid="tagWhereClause" />
    </select>

    <select id="selectTags" resultType="com.jt.learning.entity.Tag">
        select
            id,
            tag_type,
            parent_id,
            code,
            name,
            description,
            sort_order
        from tags
        <include refid="tagWhereClause" />
        order by sort_order asc, id asc
        limit #{limit}
        offset #{offset}
    </select>
</mapper>
