<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jt.learning.mapper.ArticleGenerationMetadataMapper">

    <insert id="insertArticleGenerationMetadata">
        insert into article_generation_metadata (
            question_id,
            seed,
            blueprint,
            created_at
        ) values (
            #{questionId},
            #{seed},
            cast(#{blueprint} as jsonb),
            #{createdAt}
        )
    </insert>
</mapper>
